<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.local.automaintainer</string>
  <key>ProgramArguments</key><array>
    <string>/Users/REPLACE/Development/AutoMaintainer/.venv/bin/automaintainer</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/REPLACE/Development/AutoMaintainer</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/REPLACE/.local/state/automaintainer/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/REPLACE/.local/state/automaintainer/launchd-error.log</string>
</dict></plist>
